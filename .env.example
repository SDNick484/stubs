# Development settings. settings.py reads /etc/conf.d/stubs and then this folder's .env for any key the environment
# doesn't already set: copy this file to .env and edit it. On the server the installer writes /etc/conf.d/stubs.
# An empty value means the default.

# Port for `python3 app.py` (the installer binds gunicorn to 127.0.0.1 on it)
PORT=8773
# Where stubs.db and images/ live (default ./data)
DATA_DIR=
# Cloudflare Access: team domain (e.g. yourteam.cloudflareaccess.com) and the AUD tag of the /admin application
CF_TEAM_DOMAIN=
CF_AUD=
# Emails that may edit through Access, comma separated (e.g. alex@example.com,sam@example.com); empty = nobody
ADMIN_EMAILS=
# 1 = a request that didn't come through Cloudflare, to one of LAN_HOSTS, may edit
LAN_EDIT=1
# Hosts (port ignored) that count as the LAN for LAN_EDIT, comma separated
LAN_HOSTS=localhost,127.0.0.1
# 1 = anyone can browse / and /api/; 0 = everything needs an editor
PUBLIC_VIEW=1
# 1 = posters are public too; 0 = editors only
PUBLIC_POSTERS=0
# Keys for scripts (X-API-Key: <key> or Authorization: Bearer <key>): the write key, and a key that can only read
STUBS_API_KEY=
STUBS_READ_KEY=
# setlist.fm API key (https://api.setlist.fm/docs/1.0/index.html); empty = no setlist lookups
SETLISTFM_API_KEY=
# Nominatim search endpoint for venue coordinates
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# MusicBrainz web service root, for linking artists
MUSICBRAINZ_URL=https://musicbrainz.org/ws/2
# Map tiles; this host is allowed in the Content-Security-Policy's img-src
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- The MCP service (stubs-mcp, docs/mcp-setup.md): Claude reads the history and can send shows to the review screen
# Where stubs-mcp reaches the app; empty = http://127.0.0.1:<PORT>
STUBS_URL=
# none = read tools only (holds STUBS_READ_KEY); import = also import_shows and list_imports (holds STUBS_API_KEY)
STUBS_MCP_WRITES=none
# Address, port and endpoint path stubs-mcp listens on (the tunnel route for the MCP hostname points here)
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8774
MCP_HTTP_PATH=/stubs/mcp
# Public hostname(s) of the MCP tunnel route, comma separated (e.g. mcp.example.com)
MCP_PUBLIC_HOSTS=
# AUD tag of the Cloudflare Access application on the MCP hostname (not CF_AUD, the /admin one)
CF_ACCESS_AUD=
# Access emails that may use the MCP tools, comma separated (e.g. alex@example.com); empty = anyone Access lets in
MCP_ALLOWED_EMAILS=

# Concert watch (#/admin/watch). Ticketmaster Discovery API key (https://developer.ticketmaster.com); empty = that
# source off
TICKETMASTER_API_KEY=
# Last.fm API key and user name: suggest artists to watch from that user's public top artists; empty = no suggestions
LASTFM_API_KEY=
LASTFM_USER=
# Where new concerts are pushed: an ntfy topic URL (e.g. https://ntfy.example.com/stubs-a1b2c3) or a webhook URL
# (e.g. a Home Assistant webhook); empty = no push. A secret, like a key
WATCH_NOTIFY_URL=
# ntfy (plain text with Title and Click headers) or json ({"title", "message", "items"})
WATCH_NOTIFY_FORMAT=ntfy
